# Development Environment Configuration Example
# Copy this file to dev.tfvars and fill in the values. Do NOT commit the copy!

supabase_access_token    = "sbp_yourdevaccesstokenhere"
supabase_organization_id = "org_yourdevorgidhere"
supabase_project_ref     = "yourprodprojectrefhere"
environment              = "dev"
region                   = "us-east-1"
db_password              = "YourStrongDevDbPassword123!"
site_url                 = "https://dev.anikajewelry.gideonjacob.in"


# AWS Deployment and Custom Domains
aws_region               = "ap-south-1"
domain_name              = "anikajewelry.gideonjacob.in"
route53_zone_name        = "gideonjacob.in"
use_custom_domain        = true
create_dns_records       = true
